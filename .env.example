# Modèle des variables d'environnement de MaisonFawzeyni.
#
# Ce fichier est versionné dans Git : il ne contient AUCUNE vraie valeur.
# Pour travailler en local : copiez-le en `.env` et remplissez les valeurs.
# Le fichier `.env` n'est jamais envoyé sur Git (voir .gitignore).
#
# Règle de sécurité : une variable qui commence par NEXT_PUBLIC_ est envoyée
# au navigateur du client. Aucun secret ne doit donc commencer par NEXT_PUBLIC_.

# --- Base de données (PostgreSQL hébergé chez Neon) ---
# Neon → votre projet → bouton « Connect » → copier la chaîne de connexion.
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HÔTE/NOM_BASE?sslmode=require
#
# Utilisée par le site. Adresse AVEC « -pooler » : le pool partage les connexions
# entre les visiteurs.
DATABASE_URL="postgresql://utilisateur:mot_de_passe@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# Utilisée par l'outil Prisma (migrations). Même adresse, SANS « -pooler » :
# modifier la structure de la base demande une connexion directe.
DIRECT_URL="postgresql://utilisateur:mot_de_passe@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Paiement ---
# Le prestataire branché : "demo" (aucun argent réel) tant que Wave n'est pas configuré.
PAYMENT_PROVIDER="demo"

# Clé secrète qui signe les webhooks de paiement (au moins 32 caractères, à garder secrète).
# Pour en fabriquer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET="remplacez-moi-par-une-longue-cle-aleatoire"

# Les variables suivantes seront ajoutées au fil des étapes :
# - authentification admin (phase 7)
# - clés API du vrai prestataire Wave / Orange Money (phase 6)
